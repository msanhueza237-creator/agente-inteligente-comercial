# PEGAR EN DOKPLOY > AGENTE INTELIGENTE COMERCIAL > ENVIRONMENT
# No pegar estas credenciales en Supabase, CRM, Vite ni GitHub.

ENV=production
DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@db:5432/clima_agent
DATABASE_URL_DIRECT=postgresql+asyncpg://USUARIO:CLAVE@db:5432/clima_agent
AGENT_DB_PASSWORD=REEMPLAZAR

# CRM. Llave restringida: prospecting:execute y agent-hub:execute.
CRM_MODE=http
CRM_BASE_URL=https://supabase.latinchile.cl/functions/v1/crm-agent
CRM_API_KEY=REEMPLAZAR
CRM_WORKER_ID=climactiva-worker-01
CRM_TIMEOUT_SECONDS=15

# Facto ERP - SOLO LECTURA
FACTO_ENABLED=false
FACTO_API_BASE_URL=https://api-billing.koywe.com/V1
FACTO_CLIENT_ID=PEGAR_MANANA
FACTO_CLIENT_SECRET=PEGAR_MANANA
FACTO_USERNAME=PEGAR_MANANA
FACTO_PASSWORD=PEGAR_MANANA
FACTO_READ_ONLY=true
FACTO_SYNC_INTERVAL_MINUTES=30
FACTO_REQUEST_TIMEOUT_SECONDS=30

# Tiendanube climactiva.cl - SOLO LECTURA
TIENDANUBE_ENABLED=false
TIENDANUBE_API_BASE_URL=https://api.tiendanube.com/v1
TIENDANUBE_STORE_ID=PEGAR_MANANA
TIENDANUBE_ACCESS_TOKEN=PEGAR_MANANA
TIENDANUBE_USER_AGENT=ClimaActivaCRM/1.0 (msanhueza@latinchile.cl)
TIENDANUBE_READ_ONLY=true
TIENDANUBE_SYNC_INTERVAL_MINUTES=15
TIENDANUBE_REQUEST_TIMEOUT_SECONDS=30

HUB_WORKER_ID=climactiva-hub-01
HUB_POLL_SECONDS=15
HUB_LEASE_SECONDS=120
HUB_HEARTBEAT_SECONDS=30

# Conservar los valores actuales ya conectados.
GOOGLE_MAPS_API_KEY=CONSERVAR_VALOR_ACTUAL
BRAVE_SEARCH_API_KEY=CONSERVAR_VALOR_ACTUAL
SESSION_SECRET_KEY=CONSERVAR_VALOR_ACTUAL

# Meta permanece diferido hasta su aprobacion.
